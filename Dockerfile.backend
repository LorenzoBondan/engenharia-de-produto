# Multi-stage build para Backend Spring Boot

# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copiar pom.xml e fazer download de dependências (cache layer)
COPY productengineering/pom.xml ./
COPY productengineering/domain/pom.xml ./domain/
COPY productengineering/persistence/pom.xml ./persistence/
COPY productengineering/webapi/pom.xml ./webapi/
RUN mvn dependency:go-offline -B

# Copiar código fonte
COPY productengineering/domain ./domain
COPY productengineering/persistence ./persistence
COPY productengineering/webapi ./webapi

# Build da aplicação
RUN mvn clean install -DskipTests

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Timezone e locale
ENV TZ=America/Sao_Paulo
ENV LANG=pt_BR.UTF-8
ENV LANGUAGE=pt_BR:br
ENV LC_ALL=pt_BR.UTF-8

RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apk del tzdata

# Copiar JAR da stage de build
COPY --from=build /app/webapi/target/webapi*.jar app.jar

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# Expor porta
EXPOSE 8080

# Configurar JVM para containers
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
